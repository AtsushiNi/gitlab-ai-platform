# このファイルを .env にコピーして値を設定する(.env はコミットしない)
#
# GitLab Personal Access Token(自動実行系: review単発実行・watchのPoller/Webhook経由レビュー実行用)。
# 読み取りのみで足りるため read_api スコープを推奨
# (詳細は docs/operations/security.md §4.1、docs/adr/0019-gitlab-token-scoping.md、
# references/spike-S2-gitlab-rest-api.md を参照)
GITLAB_AI_PLATFORM_GITLAB_TOKEN=

# GitLab Personal Access Token(対話型GitLab Adapter MCP Server専用、省略可)。
# 未設定の場合は GITLAB_AI_PLATFORM_GITLAB_TOKEN にフォールバックする。branch作成・push・
# MR/Issue作成等の書き込みを含むため api スコープが必要(docs/adr/0019-gitlab-token-scoping.md)
GITLAB_AI_PLATFORM_GITLAB_TOKEN_MCP=

# Webhook受信サーバー(M3-6、config.tomlの [webhook] enabled = true にする場合のみ必須)の
# Secret Token。GitLab側のWebhook設定画面の「Secret token」に同じ値を設定する
# (docs/specs/webhook-receiver.md、docs/adr/0018-webhook-receiver.md)
GITLAB_AI_PLATFORM_WEBHOOK_SECRET=

# PostgreSQL State Store(M3-5、config.tomlの [store] backend = "postgresql" にする場合のみ使用)の
# 接続パスワード。ホスト・ポート・DB名・ユーザー名は config.toml の [store.postgres] に書く
# (docs/adr/0021-state-store-postgresql.md)。backend = "sqlite"(既定)の場合は不要
GITLAB_AI_PLATFORM_STORE_POSTGRES_PASSWORD=
