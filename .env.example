# このファイルを .env にコピーして値を設定する(.env はコミットしない)
#
# GitLab Personal Access Token。レビュー用途なら read_api スコープで足りる
# (詳細は references/spike-S2-gitlab-rest-api.md を参照)
GITLAB_AI_PLATFORM_GITLAB_TOKEN=

# Webhook受信サーバー(M3-6、config.tomlの [webhook] enabled = true にする場合のみ必須)の
# Secret Token。GitLab側のWebhook設定画面の「Secret token」に同じ値を設定する
# (docs/specs/webhook-receiver.md、docs/adr/0018-webhook-receiver.md)
GITLAB_AI_PLATFORM_WEBHOOK_SECRET=
