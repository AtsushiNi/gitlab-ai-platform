{
  // D-12 (#16) docsのCIで導入。markdownlintの既定ルールセットのうち、
  // 内容に実害のない書式(行長・テーブルのパイプ位置)は対象外にする。
  // 方針はADR-0011(ruffのルール選定)と揃え、docs/adr/0013-docs-ci.md に理由を記録。
  "config": {
    "default": true,
    // MD013: 行長制限。日本語の文章・表・URLを含む行が自然に80桁を超えるため対象外
    // (ruffのE501除外と同じ理由)。
    "MD013": false,
    // MD060: テーブルの`|`の桁揃え。可読性の好みであり内容には影響しないため対象外。
    "MD060": false,
    // MD024: 見出しの重複禁止。ADRの「追記」節はその中で「決定」「却下した選択肢」等の
    // 見出しを再利用する構成(ミニADRを追記として積む形)を採るため、
    // 同じ親を共有する兄弟見出し同士の重複だけを検出する
    "MD024": { "siblings_only": true }
  },
  "globs": ["docs/**/*.md", "CLAUDE.md"]
}
